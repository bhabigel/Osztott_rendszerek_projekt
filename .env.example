# Environment Configuration
# Copy this to .env and fill in your values
# DO NOT commit .env to git - it's in .gitignore

# Server Configuration
# PORT is set in ecosystem.config.js for each PM2 instance
# PORT=3000

# Database Configuration
# MongoDB (recommended for this project)
MONGODB_URL=mongodb://localhost:27017/voting_system

# Or PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/voting_system

# Or MySQL
# DATABASE_URL=mysql://user:password@localhost:3306/voting_system

# Application Settings
NODE_ENV=development

# Session Secret for security (generate a random string in production)
SESSION_SECRET=your-secret-key-change-this-in-production

# nginx Configuration
NGINX_PORT=8081

# Optional: If using external database service
# DB_HOST=localhost
# DB_PORT=27017
# DB_NAME=voting_system
# DB_USER=admin
# DB_PASSWORD=password

# Optional: Redis for session storage (if not using ip_hash)
# REDIS_URL=redis://localhost:6379

# Optional: CORS allowed origins (comma separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Optional: Log level
# LOG_LEVEL=info
