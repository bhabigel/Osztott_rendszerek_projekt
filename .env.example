# Copy this to .env and fill in your values

# Server Configuration
# PORT is set in ecosystem.config.js for each PM2 instance
# PORT=3000

# MongoDB (Task 9 alternativa: MongoDB)
MONGODB_URL=mongodb://localhost:27017/voting_system

NODE_ENV=development

# JWT Secret — csereld le egy hosszu veletlen stringre production-ben
JWT_SECRET=change-this-to-a-long-random-secret

# nginx Configuration
NGINX_PORT=8081

# Task 9: MySQL adatbazis (ha mysql dbType-u szavazas van)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=voting_system

# Task 10: JSON-file socket szerver portja
JSONFILE_HOST=localhost
JSONFILE_PORT=5002

# Task 6: Kijelzo alkalmazas URL (display/display.py)
DISPLAY_URL=http://localhost:5001
